# Talent Recruitment System Configuration
# Copy this file to .env and fill in your values

# Database (default: SQLite for MVP, switch to PostgreSQL for production)
TRS_DATABASE_URL=sqlite:///talent_recruitment.db
# TRS_DATABASE_URL=postgresql://user:pass@localhost:5432/talent_recruitment

# Anthropic Claude API
TRS_ANTHROPIC_API_KEY=sk-ant-...

# GitHub Personal Access Token (for higher rate limits)
TRS_GITHUB_TOKEN=ghp_...

# Semantic Scholar API Key (optional, increases rate limits)
TRS_SEMANTIC_SCHOLAR_API_KEY=

# Matching configuration
TRS_MATCH_TOP_N=20
TRS_MIN_MATCH_SCORE=0.3

# Claude model for matching
TRS_CLAUDE_MODEL=claude-sonnet-4-20250514

# Scheduler (hours in 24h format, SGT)
TRS_DAILY_SCAN_HOUR=6
TRS_DAILY_MATCH_HOUR=8
